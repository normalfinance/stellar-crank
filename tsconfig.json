{
	"compilerOptions": {
		"baseUrl": "./",
		"lib": ["es6", "ES2021.String"],
		"target": "es6",
		"module": "es6",
		"moduleResolution": "node",
		"outDir": "./build",
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"sourceMap": true,
		"allowSyntheticDefaultImports": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"paths": {
			"@/*": ["./src/*"]
		}
	}
}
